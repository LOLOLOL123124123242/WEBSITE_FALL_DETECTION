PORT=5000
NODE_ENV=production

# Render PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Change before deployment
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@fallsafe.local
ADMIN_PASSWORD=admin12345

# Optional: require ESP32 to send this as x-device-key header
DEVICE_API_KEY=your_esp32_device_key

# Optional alert integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_WEBHOOK_URL=
ALERT_EMAIL=
